local JIAN_CHU_YI = {
  ["建"]={"上任","出行","祈福"}, ["除"]={"扫舍","沐浴","祈福"}, ["满"]={"嫁娶","开市","交易"},
  ["平"]={"安葬","修造"}, ["定"]={"祈福","嫁娶","安床"}, ["执"]={"祭祀","祈福","捕捉"},
  ["破"]={"破屋","坏垣"}, ["危"]={"安葬","祈福"}, ["成"]={"开市","嫁娶","结婚"},
  ["收"]={"纳财","入宅","收帐"}, ["开"]={"开市","交易","开业"}, ["闭"]={"安葬","修造","筑堤"},
}
local JIAN_CHU_JI = {
  ["建"]={"行丧"}, ["除"]={"出行","动土"}, ["满"]={"安葬"}, ["平"]={"开业","嫁娶"},
  ["定"]={"出行","动土"}, ["执"]={"嫁娶"}, ["破"]={"上任","出行"}, ["危"]={"出行","动土"},
  ["成"]={"安葬"}, ["收"]={"开业","嫁娶"}, ["开"]={"安葬","动土"}, ["闭"]={"开市","嫁娶"},
}

-- 简单 contains（数组）
local function contains(t, v)
  for _, x in ipairs(t) do
    if x == v then return true end
  end
  return false
end

-- 干支纪年偏移（农历年）
local function yearGanZhi(lYear)
  local gi = (lYear - 4) % 10
  local zi = (lYear - 4) % 12
  return Gan[gi + 1], Zhi[zi + 1], Animals[zi + 1]
end

-- 日本干支（儒略日公式，已验证）：stem=(jd+9)%10, branch=(jd+1)%12
local function dayGanZhi(jdNum)
  local g = Gan[(jdNum + 9) % 10 + 1]
  local z = Zhi[(jdNum + 1) % 12 + 1]
  return g, z
end

-- 节气月支（用 jieqi 判断某公历日位于哪个节月），用于建除
-- 农历月支：立春->寅, 惊蛰->卯, 清明->辰, 立夏->巳, 芒种->午, 小暑->未,
--           立秋->申, 白露->酉, 寒露->戌, 立冬->亥, 大雪->子, 小寒->丑
local JIE_ZHI = { "寅","卯","辰","巳","午","未","申","酉","戌","亥","子","丑" }

-- ============ 对外功能 ============

-- 返回公历(y,m,d)当日节气名（"节"），无则 nil
local jieqiCache = {}
function M.jieQiOf(y, m, d)
  local key = y * 10000 + m * 100 + d
  if jieqiCache[key] then
    return jieqiCache[key]
  end
  local row = JIE[y - 1900]
  local result = nil
  if row then
    for i, pair in ipairs(row) do
      if pair[1] == m and pair[2] == d then
        result = JIE_NAMES[i]
        break
      end
    end
  end
  jieqiCache[key] = result
  return result
end

-- 根据日期算出所在节月地支索引(0..11)，用于建除
-- 规则：找一个 <= 该日 的最近节（立春~小寒），对应地支。若在一月且未到小寒则为前一年的丑(小寒前)。
local function monthZhiIndex(y, m, d)
  local jdNum = lunar.toJulianDay(y, m, d)
  -- 从该日往回找节（最多回 60 天），找到即其地支
  for back = 0, 62 do
    local yy, mm, dd = lunar.fromJulianDay(jdNum - back)
    local jq = M.jieQiOf(yy, mm, dd)
    if jq then
      for i, name in ipairs(JIE_NAMES) do
        if name == jq then
          return JIE_ZHI[i]
        end
      end
    end
  end
  -- 兜底：按公历月近似（1-2月寅春前…）——极少用到
  local fallback = { "丑","寅","卯","辰","巳","午","未","申","酉","戌","亥","子" }
  return fallback[m]
end

-- 农历月干支（节月），用年干 + 五虎遁 求月干
-- 月支 mzIdx 对应 寅=2 起，正月的天干由年干决定：
--   甲己之年丙作首(寅月甲)… 简化用公式：(年干idx*2 + 月支序) % 10
local function monthGanZhiFor(y, m, d, mzIdx)
  -- 年干（农历年干支[0]）
  local l = lunar.fromSolar(y, m, d)
  local ygIdx = (l.year - 4) % 10
  -- 五虎遁：寅月起。月支在寅=2..丑=11 序列中的序号 = (mzIdx - 2 + 12) % 12 (寅=0)
  local pos = (mzIdx - 2 + 12) % 12 -- 寅=0,卯=1,...丑=11
  -- 月干 idx = (ygIdx * 2 + pos) % 10
  local mgIdx = (ygIdx * 2 + pos) % 10
  return Gan[mgIdx + 1] .. Zhi[mzIdx + 1]
end

-- 星期中文
local WEEK = { "星期一","星期二","星期三","星期四","星期五","星期六","星期日" }
local function weekdayCn(y, m, d)
  local w = (lunar.toJulianDay(y, m, d) + 1) % 7 -- 0=周日
  return WEEK[w + 1]
end

-- 单日完整黄历信息
-- 返回字段见 doc 注释
local dayCache = {}
function M.dayInfo(y, m, d)
  local key = y * 10000 + m * 100 + d
  if dayCache[key] then
    return dayCache[key]
  end
  local jdNum = lunar.toJulianDay(y, m, d)
  local l = lunar.fromSolar(y, m, d) -- {year,month,day,isLeap,monthStr,dayStr,yearGanZhi,shengXiao}
  local dayG, dayZ = dayGanZhi(jdNum)
  local mzIndexName = monthZhiIndex(y, m, d) -- 返回地支名
  local mzIdx = ZHI_IDX[mzIndexName]

  -- 建除十二神：月支 -> "建"位置；日支递增。建 = (月支idx 对应) + 日支差
  -- 传统：正月建寅，即月支即"建"。十二神序号 = (日支idx - 月支idx) mod 12
  local dZhiIdx = ZHI_IDX[dayZ]
  local jianChuIdx = (dZhiIdx - mzIdx + 12) % 12
  local jianChuName = JIAN_CHU[jianChuIdx + 1]

  -- 值神：序号 = (月支offset + 日支idx) mod 12
  local tsIdx = (TS_OFFSET[mzIndexName] + dZhiIdx) % 12
  local tsName = TIAN_SHEN[tsIdx + 1]

  -- 节气
  local jq = M.jieQiOf(y, m, d)
  -- 节日（针对详情页提醒：阳历节日 + 农历节日；复用在 lunar.getHolidayL）
  local holType, holName = lunar.getHolidayL(l) -- 农历节日: "lunar", 名
  if not holName then
    for _, sh in ipairs(lunar.solarHolidays) do
      if sh[1] == m and sh[2] == d then
        holType, holName = "solar", sh[3]
        break
      end
    end
  end
  -- 月相
  local lDay = l.day
  local yueXiang = YUE_XIANG[lDay] or YUE_XIANG[#YUE_XIANG]
  -- 冲煞
  local chong = chongShengXiao(dayZ)
  local sha = SHA[dayZ]

  -- 干支年（农历年，**立春切换**）
  -- 黄历"太岁"年干支按立春切换：公历日已过(含)当年立春 -> 用公历年对应干支；立春前 -> 公历年-1
  -- 而农历 l.year 要到正月初一才切到公历年，二者在"立春~正月初一"窗口内不同，故须按立春现判。
  local effYear = l.year
  local lchun = JIE[y - 1900] and JIE[y - 1900][1] -- 立春 {月,日}
  if lchun and ((m > lchun[1]) or (m == lchun[1] and d >= lchun[2])) then
    effYear = y -- 已过立春，黄历干支年 = 公历年
  else
    effYear = y - 1 -- 立春前，干支年为公历年-1
  end
  local yg, yz, animal = yearGanZhi(effYear)

  -- 节气月干支：月支 + 由年干推月干（五虎遁年上起月，简化用节气月支）
  local monthGanZhiS = monthGanZhiFor(y, m, d, mzIdx)

  -- 宜/忌（简化合并）
  local tsType = TS_TYPE[tsName]
  local tsLuck = TS_LUCK[tsName]
  local yi = {}
  local ji = {}
  for _, v in ipairs(YI_FOR_TYPE[tsType]) do table.insert(yi, v) end
  for _, v in ipairs(JI_FOR_TYPE[tsType]) do table.insert(ji, v) end
  for _, v in ipairs(JIAN_CHU_YI[jianChuName] or {}) do
    if not contains(yi, v) then table.insert(yi, v) end
  end
  for _, v in ipairs(JIAN_CHU_JI[jianChuName] or {}) do
    if not contains(ji, v) then table.insert(ji, v) end
  end

  local info = {
    -- 基础
    solar    = string.format("%04d.%02d.%02d", y, m, d),
    weekCn   = weekdayCn(y, m, d),
    -- 农历
    lunarY   = l.year,
    lunarM   = l.month,
    lunarD   = l.day,
    isLeap   = l.isLeap,
    lunarStr = l.dayStr,             -- "初八"
    monthStr = l.monthStr,           -- "六月"/"闰六月"
    -- 干支
    yearGanZhi  = yg .. yz,          -- "丙午"
    yearAnimal  = animal,            -- "马"
    dayGanZhi   = dayG .. dayZ,      -- "甲寅"
    dayNian     = string.format("%s%s年 %s%s", yg, yz, l.monthStr, l.dayStr),
    -- 月支（节月地支）
    monthZhi    = mzIndexName,
    monthGanZhi = monthGanZhiS,      -- "甲申"
    -- 择吉
    jianChu     = jianChuName,       -- "建"/"除"...
    tianShen    = tsName,            -- "青龙"
    tianShenType= tsType,            -- "黄道"/"黑道"
    tianShenLuck= tsLuck,            -- "吉"/"凶"
    chong       = chong,             -- "虎"
    sha         = sha,               -- "南"
    yueXiang    = yueXiang,          -- "望"
    jieQi       = jq,                -- "立秋" or nil
    holType     = holType,           -- "solar"/"lunar"/nil（节日类型）
    holDay      = holName,           -- "中秋节"/"元旦"/nil（节日名，用于详情页提醒）
    yi          = yi,                -- 宜列表
    ji          = ji,                -- 忌列表
    -- 简化的"冲X煞Y" / "黄黑道吉凶" 组合串
    labelChong  = "冲" .. chong .. " 煞" .. sha,
    labelType   = tsName .. "(" .. tsType .. tsLuck .. ")",
  }
  dayCache[key] = info
  return info
end

-- 农历月干支（节月），用年干 + 五虎遁 求月干
-- 月支 mzIdx 对应 寅=2 起，正月的天干由年干决定：
--   甲己之年丙作首(寅月甲)… 简化用公式：(年干idx*2 + 月支序) % 10
-- 月支序(0=寅)... 这里用节月地支的序号在"寅起始"体系中的位置
local function monthGanZhiFor(y, m, d, mzIdx)
  -- 年干（农历年干支[0]）
  local l = lunar.fromSolar(y, m, d)
  local ygIdx = (l.year - 4) % 10
  -- 五虎遁：寅月起。月支在寅=2..丑=11 序列中的序号 = (mzIdx - 2 + 12) % 12 (寅=0)
  local pos = (mzIdx - 2 + 12) % 12 -- 寅=0,卯=1,...丑=11
  -- 月干 idx = (ygIdx * 2 + pos) % 10
  local mgIdx = (ygIdx * 2 + pos) % 10
  return Gan[mgIdx + 1] .. Zhi[mzIdx + 1]
end

-- 星期中文
local WEEK = { "星期一","星期二","星期三","星期四","星期五","星期六","星期日" }
-- 农历日数字中文（大写的"初八"）
-- lunar.fromSolar 已给 dayStr，这里补充一个简化纯数字版用于大字展示
local DayNum = { "一","二","三","四","五","六","七","八","九","十",
  "十一","十二","十三","十四","十五","十六","十七","十八","十九","二十",
  "廿一","廿二","廿三","廿四","廿五","廿六","廿七","廿八","廿九","三十" }

-- 生成某农历月的起始公历日（用于月历标注该月首日），可选
function M.monthStartPivot()

end

return M

end)()

local detail = (function()
-- detail.luau — 单日台历详情视图（纯展示）
-- 输入 calendar.dayInfo 的 info 表，输出页面上层的 ui 内容数组。
-- 布局：大字"初八" + 公历/农历/干支标题 + 节气/月相色块 + 冲煞/值神/建除 + 宜忌。

-- 节气给一个柔和背景色，让当日节气一眼可见
local JIEQI_BG = {
  ["立春"]= "primary/0.18", ["雨水"]= "primary/0.13", ["惊蛰"]= "primary/0.18", ["春分"]= "primary/0.13",
  ["清明"]= "secondary/0.18", ["谷雨"]= "secondary/0.13", ["立夏"]= "secondary/0.18", ["小满"]= "secondary/0.13",
  ["芒种"]= "tertiary/0.18", ["夏至"]= "tertiary/0.13", ["小暑"]= "tertiary/0.18", ["大暑"]= "tertiary/0.13",
  ["立秋"]= "primary/0.22", ["处暑"]= "primary/0.12", ["白露"]= "primary/0.18", ["秋分"]= "primary/0.12",
  ["寒露"]= "secondary/0.18", ["霜降"]= "secondary/0.12", ["立冬"]= "secondary/0.18", ["小雪"]= "secondary/0.12",
  ["大雪"]= "tertiary/0.18", ["冬至"]= "tertiary/0.12", ["小寒"]= "tertiary/0.18", ["大寒"]= "tertiary/0.12",
}

-- 胶囊标签：用 column 包 fill+padding+radius，内嵌 label
local function chip(text, color, fill)
  return ui.column({ padding = 4, radius = 6, fill = fill or "surface_variant/0.2" }, {
    ui.label({ text = text, fontSize = 11, color = color or "on_surface", maxLines = 1, textAlign = "center" }),
  })
end

-- 自适应胶囊：flexGrow 均分列宽，label maxLines=0 允许英文长文本在列内换行
-- （解决英文干支/翻译等超底板；中文短串不触发换行仍单行居中）
local function chipCol(text, color, fill)
  return ui.column({ padding = 4, radius = 6, fill = fill or "surface_variant/0.2", flexGrow = 1 }, {
    ui.label({ text = text, fontSize = 11, color = color or "on_surface", maxLines = 0, textAlign = "center" }),
  })
end

local M = {}

-- 返回详情内容数组（panel 负责外层容器 + 导航行）
function M.view(d)
  local header = ui.row({ gap = 4, align = "center", justify = "space_between" }, {
    chip(d.solar .. "  " .. i18n.weekday(d.weekCn)),
    chip(i18n.tianShen(d.tianShen) .. " (" .. i18n.way(d.tianShenType) .. "/" .. i18n.luck(d.tianShenLuck) .. ")"),
  })

  -- 节日提醒横幅：当天是传统节日（农历/阳历）时显示，醒目提示
  -- 详情页空间充足，可以显示完整英文译名
  local holidayReminder
  if d.holDay and d.holDay ~= "" then
    holidayReminder = ui.row({ gap = 8, align = "center", padding = 8, radius = 8, fill = "tertiary/0.16" }, {
      ui.label({ text = "🎉", fontSize = 16, color = "tertiary", maxLines = 1 }),
      ui.label({ text = i18n.holiday(d.holDay), fontSize = 14, fontWeight = "bold", color = "tertiary", maxLines = 1, flexGrow = 1 }),
    })
  end

  -- 大区: 农历日大字 + 农历月
  local bigBlock = ui.row({ gap = 14, align = "center" }, {
    ui.label({
      text = i18n.lunarDay(d.lunarStr or ""),
      fontSize = 46,
      fontWeight = "bold",
      color = "on_surface",
      flexGrow = 1,
      maxLines = 1,
    }),
    ui.column({ gap = 4, align = "end" }, {
      ui.label({
        text = i18n.lunarMonth(d.monthStr, d.isLeap),
        fontSize = 20,
        fontWeight = "bold",
        color = "primary",
        maxLines = 1,
      }),
      ui.label({ text = i18n.dayNian(d.dayNian), fontSize = 12, color = "on_surface_variant", maxLines = 1 }),
    }),
  })

  -- 节气 / 月相 条
  local bannerCells = {}
  if d.jieQi and d.jieQi ~= "" then
    table.insert(bannerCells, chip(i18n.struct("节气") .. " · " .. i18n.jieQi(d.jieQi), "on_surface", JIEQI_BG[d.jieQi] or "error/0.2"))
  end
  if d.yueXiang and d.yueXiang ~= "" then
    table.insert(bannerCells, chip(i18n.struct("月相") .. " · " .. i18n.yueXiang(d.yueXiang)))
  end
  local banner
  if #bannerCells > 0 then
    banner = ui.row({ gap = 6, align = "center" }, bannerCells)
  else
    banner = ui.spacer()
  end

  -- 信息网格：建除 / 值神 / 冲煞 / 干支（用 chipCol 均分列宽，英文长文本自动换行）
  local infoRows = ui.column({ gap = 4 }, {
    ui.row({ gap = 4, align = "center" }, {
      chipCol(i18n.struct("建除") .. " · " .. i18n.jianChu(d.jianChu)),
      chipCol(i18n.struct("值神") .. " · " .. i18n.tianShen(d.tianShen)),
      chipCol(i18n.struct("冲") .. i18n.animal(d.chong) .. "  " .. i18n.struct("煞") .. i18n.dir(d.sha)),
    }),
    ui.row({ gap = 4, align = "center" }, {
      chipCol(i18n.struct("日") .. " · " .. i18n.romanizeGanzhi(d.dayGanZhi)),
      chipCol(i18n.struct("月") .. " · " .. i18n.romanizeGanzhi(d.monthGanZhi)),
      chipCol(i18n.struct("年") .. " · " .. i18n.romanizeGanzhi(d.yearGanZhi) .. i18n.animal(d.yearAnimal)),
    }),
  })

  -- 宜 / 忌：把数组拼接成多行文本
  local function wrapLines(title, items, color)
    local ret = { ui.label({ text = title, fontSize = 12, fontWeight = "bold", color = color, maxLines = 1 }) }
    if not items or #items == 0 then
      table.insert(ret, ui.label({ text = "—", fontSize = 12, color = "on_surface_variant", maxLines = 1 }))
      return ui.column({ gap = 4 }, ret)
    end
    local line = {}
    for i, v in ipairs(items) do
      table.insert(line, v)
      -- 每 4 个一组换行
      if #line == 4 or i == #items then
        table.insert(ret, ui.label({ text = table.concat(line, i18n.sepList()), fontSize = 11, color = color, maxLines = 0 }))
        line = {}
      end
    end
    return ui.column({ gap = 4 }, ret)
  end

  local yiItems = i18n.activityList(d.yi)
  local jiItems = i18n.activityList(d.ji)
  local yiBlock = ui.column({ gap = 8, padding = 10, radius = 10, fill = "primary/0.08", flexGrow = 1 }, {
    wrapLines(i18n.struct("宜"), yiItems, "primary"),
  })
  local jiBlock = ui.column({ gap = 8, padding = 10, radius = 10, fill = "error/0.08", flexGrow = 1 }, {
    wrapLines(i18n.struct("忌"), jiItems, "error"),
  })

  local yiJi = ui.row({ gap = 10, align = "center" }, { yiBlock, jiBlock })

  return {
    header,
    holidayReminder,           -- 节日提醒横幅（无节日时为 nil，不渲染）
    bigBlock,
    banner,
    infoRows,
    yiJi,
  }
end

return M

end)()

--!nonstrict
-- panel.luau — 农历月历面板
-- 点开是完整月历（周一起始），点击任意格子进入单日台历详情（◀▶ 前后天切换）。
-- 顶部 bar widget 点开此面板。



-- 视图状态
local view = {
  mode = "month", -- "month" 月历 / "detail" 单日详情
  y = 0, m = 0, d = 0, -- 当前查看的年/月/（详情时的日）
}

-- 今天
local todayY, todayM, todayD = 0, 0, 0

-- 某日在一周中的索引 0=周一 ... 6=周日
local function weekday1Monday(y, m, d)
  local jd = lunar.toJulianDay(y, m, d)
  local w = (jd + 1) % 7
  return (w + 6) % 7 -- 0=周一
end

local function monthGridInfo(y, m)
  local firstDow = weekday1Monday(y, m, 1)
  local nextY, nextM = y, m + 1
  if nextM > 12 then nextM = 1; nextY = y + 1 end
  local daysInMonth = lunar.toJulianDay(nextY, nextM, 1) - lunar.toJulianDay(y, m, 1)
  return firstDow, daysInMonth
end

local function nextMonth(y, m)
  if m == 12 then return y + 1, 1 else return y, m + 1 end
end
local function prevMonth(y, m)
  if m == 1 then return y - 1, 12 else return y, m - 1 end
end
-- 前后一天（从儒略日编号算）
local function addDays(y, m, d, n)
  return lunar.fromJulianDay(lunar.toJulianDay(y, m, d) + n)
end

-- 回到当月/今日
local function goToday()
  view.mode = "month"
  view.y, view.m, view.d = todayY, todayM, todayD
  render()
end

function init()
  todayY = tonumber(noctalia.formatTime("%Y", nil, "") or "0")
  todayM = tonumber(noctalia.formatTime("%m", nil, "") or "0")
  todayD = tonumber(noctalia.formatTime("%d", nil, "") or "0")
  if view.y == 0 then
    view.y, view.m, view.d = todayY, todayM, todayD
  end
end

-- 点击某格 -> 跳到详情
local function openDetail(y, m, d)
  view.mode = "detail"
  view.y, view.m, view.d = y, m, d
  render()
end
local function backToMonth()
  view.mode = "month"
  render()
end
local function stepDay(n)
  view.y, view.m, view.d = addDays(view.y, view.m, view.d, n)
  render()
end

-- ============ 月历视图 ============

-- l 为调用方已算好的该公历日农历表（不得在此内部再调 fromSolar，避免整月渲染超 CPU 预算）
local function dayCell(y, m, d, isCurrentMonth, l)
  local isToday = (y == todayY and m == todayM and d == todayD)
  local isWeekend = (weekday1Monday(y, m, d) >= 5)
  local htype, hname = lunar.getHolidayL(l)

  local sub = l.dayStr
  if l.day == 1 then
    sub = l.monthStr
  end

  local mainColor = "on_surface"
  if isToday then
    mainColor = "primary"
  elseif not isCurrentMonth then
    mainColor = "on_surface_variant"
  elseif hname then
    mainColor = "error"
  elseif isWeekend then
    mainColor = "secondary"
  end

  -- 月历格子副文字一律用中文（节日原文 / 农历原文），不做英文翻译：
  -- 英文译名太长挤不下格子（如 Mid-Autumn Festival），完整英文留给黄历详情页。
  local subText = hname or sub
  local subColor = "on_surface_variant"
  if hname then
    subColor = "error"
  elseif l.day == 1 then
    subColor = "secondary"
  end

  local onClick = function() openDetail(y, m, d) end
  -- 等宽：flexGrow 让 7 列均分父容器宽度保证列对齐；数字右对齐贴近右侧，符合日历习惯
  local fill = isToday and "primary/0.18" or nil
  return ui.column({ flexGrow = 1, padding = 2, align = "center", fill = fill, onClick = onClick }, {
    ui.label({ text = tostring(d), color = mainColor, fontWeight = "bold", fontSize = 13, textAlign = "end" }),
    ui.label({ text = subText, color = subColor, fontSize = 9, maxLines = 1, textAlign = "end" }),
  })
end

local function renderMonth()
  local y, m = view.y, view.m
  local titleText = i18n.monthTitle(y, m)
  local firstDow, daysInMonth = monthGridInfo(y, m)

  local rows = {}
  -- 周表头：flexGrow 均分宽度，与下方日期行同 gap，保证一~日与各列对齐
  -- 表头与日期格同结构：每列用 flexGrow=1 的 column + align=center 包裹，保证文字在自己列内水平居中
  local hd = i18n.weekHeader()
  local hc = { "on_surface_variant", "on_surface_variant", "on_surface_variant", "on_surface_variant", "on_surface_variant", "secondary", "secondary" }
  local weekHeader = {}
  for i = 1, 7 do
    table.insert(weekHeader, ui.column({ flexGrow = 1, align = "center" }, {
      ui.label({ text = hd[i], color = hc[i], fontSize = 11 }),
    }))
  end
  table.insert(rows, ui.row({ gap = 6 }, weekHeader))

  local cellY, cellM, cellD = y, m, 1
  local prefix = firstDow
  if prefix > 0 then
    cellY, cellM, cellD = lunar.fromJulianDay(lunar.toJulianDay(y, m, 1) - prefix)
  end
  -- 首格农历基准只算一次，后续用 lunarAdvance 逐格 O(1) 推进
  local l0 = lunar.fromSolar(cellY, cellM, cellD)

  local cells = {}
  for i = 1, 42 do
    local isCurrent = (cellY == y and cellM == m)
    if cellD > 0 and isCurrent then
      table.insert(cells, dayCell(cellY, cellM, cellD, true, l0))
    else
      table.insert(cells, ui.column({ flexGrow = 1 }))
    end
    cellY, cellM, cellD = lunar.fromJulianDay(lunar.toJulianDay(cellY, cellM, cellD) + 1)
    l0 = lunar.fromLunarAdvance(l0)
  end

  for row = 0, 5 do
    local week = {}
    for col = 1, 7 do
      table.insert(week, cells[row * 7 + col])
    end
    table.insert(rows, ui.row({ gap = 6 }, week))
  end

  local lNow = lunar.fromSolar(todayY, todayM, todayD)

  panel.render(ui.column({ gap = 8, padding = 10 }, {
    -- 顶栏：<上一月  上一年  年月标题  下一年  下一月>
    ui.row({ align = "center", justify = "space_between" }, {
      ui.button({ glyph = "chevron-left", tooltip = "上一月", variant = "ghost", onClick = function()
        view.y, view.m = prevMonth(view.y, view.m)
        render()
      end }),
      ui.button({ glyph = "player-skip-back-filled", tooltip = "上一年", variant = "ghost", onClick = function()
        view.y = view.y - 1
        render()
      end }),
      ui.label({ text = titleText, fontWeight = "bold", fontSize = 16, flexGrow = 1, textAlign = "center" }),
      ui.button({ glyph = "player-skip-forward-filled", tooltip = "下一年", variant = "ghost", onClick = function()
        view.y = view.y + 1
        render()
      end }),
      ui.button({ glyph = "chevron-right", tooltip = "下一月", variant = "ghost", onClick = function()
        view.y, view.m = nextMonth(view.y, view.m)
        render()
      end }),
    }),
    ui.label({
      text = string.format("今日：%d-%02d-%02d  %s", todayY, todayM, todayD, lNow.monthStr .. lNow.dayStr),
      color = "secondary",
      fontSize = 11,
    }),
    ui.button({ text = "回到今日", variant = "text", size = "small", onClick = goToday }),
    rows[1],
    (function()
      local grid = {}
      for i = 2, #rows do
        table.insert(grid, rows[i])
      end
      return ui.column({ gap = 4 }, grid)
    end)(),
    -- 提示
    ui.label({ text = "点击任意日期查看单日黄历", color = "on_surface_variant", fontSize = 9, textAlign = "center" }),
  }))
end

-- ============ 单日详情视图 ============

local function renderDetail()
  local d = calendar.dayInfo(view.y, view.m, view.d)
  local titleText = string.format("%d年%d月%d日  %s", view.y, view.m, view.d, d.weekCn)

  panel.render(ui.column({ gap = 8, padding = 10, flexGrow = 1 }, {
    -- 顶栏：返回 + 标题 + 前后天
    ui.row({ align = "center", gap = 6 }, {
      ui.button({ glyph = "arrow-left", variant = "ghost", tooltip = "返回月历", onClick = backToMonth }),
      ui.spacer(),
      ui.label({ text = titleText, fontWeight = "bold", fontSize = 14, maxLines = 1, flexGrow = 1 }),
      ui.spacer(),
      ui.button({ glyph = "chevron-left", variant = "ghost", onClick = function() stepDay(-1) end }),
      ui.button({ glyph = "chevron-right", variant = "ghost", onClick = function() stepDay(1) end }),
    }),
    -- 详情主体：包一层 ui.scroll 垂直滚动，内容（尤其英文折行后）超出面板高度时可滚动查看
    -- scroll flexGrow=1 填满顶栏之外的剩余面板高度，内容超高即出现滚动条（不撑破面板）
    ui.scroll({ gap = 8, flexGrow = 1 }, detail.view(d)),
  }))
end

-- ============ 渲染入口 ============

function render()
  init()
  if view.mode == "detail" then
    renderDetail()
  else
    renderMonth()
  end
end

function onOpen()
  init()
  -- 每次打开面板都回到当前月，避免停留在之前翻到的远月份
  view.mode = "month"
  view.y, view.m, view.d = todayY, todayM, todayD
  render()
end

function update()
  noctalia.setUpdateInterval(60000)
  local ny = tonumber(noctalia.formatTime("%Y", nil, "") or "0")
  local nm = tonumber(noctalia.formatTime("%m", nil, "") or "0")
  local nd = tonumber(noctalia.formatTime("%d", nil, "") or "0")
  if ny ~= todayY or nm ~= todayM or nd ~= todayD then
    init()
    render()
  end
end

init()
